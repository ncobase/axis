{
  "extends": "@ncobase/tsconfig/react.json",
  "include": [
    "src/**/*",
    "*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ncobase/utils": ["../utils/src/index.ts"],
      "@ncobase/utils/*": ["../utils/src/*"]
    }
  }
}
